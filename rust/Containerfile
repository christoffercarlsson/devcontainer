ARG BASE=base

FROM ghcr.io/christoffercarlsson/devcontainers/${BASE}:latest

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends rustup \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN rustup toolchain install stable \
    && rustup component add rust-analyzer rust-src

LABEL org.opencontainers.image.source="https://github.com/christoffercarlsson/devcontainers" \
      org.opencontainers.image.authors="Christoffer Carlsson <cc@christoffercarlsson.com>" \
      org.opencontainers.image.description="Rust development container" \
      org.opencontainers.image.licenses="Unlicense" \
      org.opencontainers.image.title="rust"

ENTRYPOINT ["/usr/local/sbin/entrypoint"]
