[core]
    pager = delta
[delta]
    navigate = true
    side-by-side = true
    dark = true
    minus-style = bold red 52
    minus-emph-style = reverse bold red 52
    minus-non-emph-style = bold red 52
    plus-style = bold green 22
    plus-emph-style = reverse bold green 22
    plus-non-emph-style = bold green 22
    whitespace-error-style = reverse red
    line-numbers-minus-style = red
    line-numbers-zero-style = brightblack
    line-numbers-plus-style = green
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictStyle = zdiff3
