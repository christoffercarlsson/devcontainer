FROM ghcr.io/christoffercarlsson/devcontainers/base:latest AS runtime

RUN npm install -g --ignore-scripts \
        typescript-language-server \
        @biomejs/biome \
    && npm cache clean --force

ENTRYPOINT ["/usr/local/sbin/entrypoint"]

LABEL org.opencontainers.image.source=https://github.com/christoffercarlsson/containers
