FROM ghcr.io/christoffercarlsson/node:latest AS node-tools-builder

RUN npm install -g --ignore-scripts \
    bash-language-server \
    @earendil-works/pi-coding-agent \
    tombi

RUN npm install -g @anthropic-ai/claude-code

FROM ghcr.io/christoffercarlsson/rust:latest AS rust-tools-builder

RUN cargo install --root /usr/local \
    bat \
    eza \
    fd-find \
    jaq \
    ripgrep \
    rumdl \
    tokei

FROM ghcr.io/christoffercarlsson/debian-neovim:latest AS runtime

RUN export DEBIAN_FRONTEND=noninteractive \
    && rm -f /etc/dpkg/dpkg.cfg.d/docker \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        fish \
        fzf \
        git \
        gnupg \
        less \
        man-db \
        manpages \
        manpages-dev \
        openssh-server \
        shfmt \
        stow \
        tmux \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/entrypoint /usr/local/sbin/entrypoint
COPY configs/sshd.conf /etc/ssh/sshd_config.d/devcontainer.conf

COPY --from=ghcr.io/christoffercarlsson/lua-language-server:latest \
    /opt/lua-language-server /opt/lua-language-server
COPY --from=ghcr.io/christoffercarlsson/lua-language-server:latest \
    /usr/local/bin/lua-language-server /usr/local/bin/lua-language-server

COPY --from=node-tools-builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node-tools-builder /usr/local/bin /usr/local/bin

COPY --from=rust-tools-builder /usr/local/bin/ /usr/local/bin/

RUN groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid dev --shell /bin/fish --create-home dev \
    && install -o dev -g dev -d /workspace

USER dev
WORKDIR /home/dev

COPY --chown=dev:dev scripts/bash /home/dev/.bash.local
COPY --chown=dev:dev scripts/fish /home/dev/.fish.local

RUN rm .bashrc

RUN git clone https://github.com/christoffercarlsson/dotfiles .dotfiles \
    && cd .dotfiles \
    && stow bash \
        biome \
        claude \
        fish \
        git \
        neovim \
        pi \
        rumdl \
        scripts \
        tmux \
        vim

USER root
WORKDIR /workspace

EXPOSE 22

ENTRYPOINT ["/usr/local/sbin/entrypoint"]

LABEL org.opencontainers.image.source=https://github.com/christoffercarlsson/containers
