ARG BASE=debian:trixie-slim

FROM debian:trixie-slim AS neovim-builder

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        gettext \
        git \
        ninja-build

RUN git clone --depth 1 --branch stable \
        https://github.com/neovim/neovim /tmp/neovim \
    && cd /tmp/neovim \
    && make CMAKE_BUILD_TYPE=Release \
    && make CMAKE_INSTALL_PREFIX=/tmp/nvim install

RUN git clone --depth 1 --branch 3.18.2 \
        https://github.com/LuaLS/lua-language-server /tmp/lua-language-server \
    && cd /tmp/lua-language-server \
    && chmod +x ./make.sh \
    && ./make.sh > /dev/null

FROM node:24-slim AS node-tools-builder

RUN npm install -g --ignore-scripts \
    bash-language-server \
    @earendil-works/pi-coding-agent \
    tombi

RUN npm install -g @anthropic-ai/claude-code

FROM rust:1-trixie AS rust-tools-builder

RUN cargo install --root /opt/rust-tools \
    bat \
    eza \
    fd-find \
    jaq \
    ripgrep \
    rumdl \
    tokei

FROM ${BASE}

ARG LANG=en_US.UTF-8
ARG TZ=Europe/Stockholm
ARG USER_SHELL=/bin/fish

ENV BAT_THEME=base16
ENV DEVCONTAINER_AUTHORIZED_KEYS=""
ENV EDITOR=nvim
ENV LANG=${LANG}
ENV LC_ALL=${LANG}
ENV TERM=xterm-256color
ENV TZ=${TZ}
ENV VISUAL=nvim

RUN export DEBIAN_FRONTEND=noninteractive \
    && rm -f /etc/dpkg/dpkg.cfg.d/docker \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        fish \
        fzf \
        git \
        gnupg \
        less \
        locales \
        man-db \
        manpages \
        manpages-dev \
        openssh-server \
        shfmt \
        stow \
        tmux \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN echo "${LANG} UTF-8" > /etc/locale.gen \
    && locale-gen

RUN groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid 1000 --shell ${USER_SHELL} --create-home dev \
    && install -o dev -g dev -d /workspace

COPY --from=neovim-builder /tmp/nvim /opt/nvim
RUN ln -s /opt/nvim/bin/nvim /usr/local/bin/nvim

COPY --from=neovim-builder /tmp/lua-language-server /opt/lua-language-server
COPY --chmod=755 scripts/lua-language-server.bash /usr/local/bin/lua-language-server

COPY --from=node-tools-builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node-tools-builder /usr/local/bin /usr/local/bin
RUN rm /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg \
    /usr/local/bin/docker-entrypoint.sh \
    /usr/local/bin/nodejs

COPY --from=rust-tools-builder /opt/rust-tools/bin/ /usr/local/bin/

COPY --chmod=700 scripts/entrypoint.bash /usr/local/sbin/entrypoint
COPY --chmod=644 configs/sshd.conf /etc/ssh/sshd_config.d/devcontainer.conf
COPY --chmod=644 --chmod=dev:dev scripts/local.bash /home/dev/.bash.local
COPY --chmod=644 --chmod=dev:dev scripts/local.fish /home/dev/.fish.local

RUN printf "\nSetEnv BAT_THEME=%s EDITOR=%s LANG=%s LC_ALL=%s TERM=%s TZ=%s VISUAL=%s" \
        "${BAT_THEME}" \
        "${EDITOR}" \
        "${LANG}" \
        "${LC_ALL}" \
        "${TERM}" \
        "${TZ}" \
        "${VISUAL}" \
    >> /etc/ssh/sshd_config.d/devcontainer.conf

USER dev
WORKDIR /home/dev

RUN rm .bashrc

RUN git clone https://github.com/christoffercarlsson/dotfiles .dotfiles \
    && cd .dotfiles \
    && stow bash \
        biome \
        claude \
        fish \
        git \
        neovim \
        pi \
        rumdl \
        scripts \
        tmux \
        vim

USER root
WORKDIR /workspace

LABEL org.opencontainers.image.source="https://github.com/christoffercarlsson/devcontainers" \
      org.opencontainers.image.authors="Christoffer Carlsson <cc@christoffercarlsson.com>" \
      org.opencontainers.image.description="Base development container" \
      org.opencontainers.image.licenses="Unlicense" \
      org.opencontainers.image.title="base"

EXPOSE 22

ENTRYPOINT ["/usr/local/sbin/entrypoint"]
