ARG BASE=base

FROM ghcr.io/christoffercarlsson/devcontainers/${BASE}:latest

ARG USERNAME=dev

USER root

RUN npm install -g \
        opencode-ai \
        @anthropic-ai/claude-code \
    && npm cache clean --force

USER ${USERNAME}

LABEL org.opencontainers.image.source="https://github.com/christoffercarlsson/devcontainers" \
      org.opencontainers.image.authors="Christoffer Carlsson <cc@christoffercarlsson.com>" \
      org.opencontainers.image.description="Base development container with OpenCode and Claude Code pre-installed" \
      org.opencontainers.image.licenses="Unlicense" \
      org.opencontainers.image.title="agentic"

CMD ["sleep", "infinity"]
